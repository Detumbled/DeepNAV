{
  "version": 3,
  "configurePresets": [
    {
      "name": "apple-clang",
      "displayName": "Apple Clang",
      "description": "Builds using the Apple Clang toolchain matched to the macOS SDK",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-clang",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/eigen;/opt/homebrew",
        "CMAKE_AR": "/usr/bin/ar",
        "CMAKE_RANLIB": "/usr/bin/ranlib",
        "CMAKE_CXX_COMPILER_AR": "/usr/bin/ar",
        "CMAKE_CXX_COMPILER_RANLIB": "/usr/bin/ranlib"
      }
    }
  ]
}
